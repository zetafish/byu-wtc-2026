{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        metosin/reitit-ring {:mvn/version "0.9.2"}
        ring/ring-core {:mvn/version "1.15.3"}
        metosin/jsonista {:mvn/version "0.3.13"}
        metosin/malli {:mvn/version "0.20.3"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql {:mvn/version "42.7.8"}
        com.zaxxer/HikariCP {:mvn/version "6.3.1"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.18"}}
 :aliases
 {:dev {:extra-paths ["dev" "test"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}}}
  :nrepl {:main-opts ["-m" "nrepl.cmdline" "--port" "7888"]}
  :run {:main-opts ["-m" "wtc.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :build {:deps {io.github.clojure/tools.build
                 {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default build}}}
